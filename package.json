{
  "name": "strudel-lab",
  "version": "2.0.0",
  "type": "module",
  "description": "Strudel Lab - algorithmic music live coding on the desktop",
  "author": "Strudel Lab (based on StrudelLive by IAmSpring)",
  "main": "electron/main.cjs",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5000 && electron .\"",
    "electron:build": "tsc --noEmit && vite build && node scripts/download-yt-dlp.mjs && electron-builder",
    "electron:build:linux": "tsc --noEmit && vite build && node scripts/download-yt-dlp.mjs && electron-builder --linux",
    "electron:build:win": "tsc --noEmit && vite build && node scripts/download-yt-dlp.mjs && electron-builder --win",
    "electron:build:mac": "tsc --noEmit && vite build && node scripts/download-yt-dlp.mjs && electron-builder --mac",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:record": "playwright test client/e2e/record-export.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm run test && npm run test:e2e",
    "lint": "eslint client/src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"client/src/**/*.{ts,tsx,css}\" \"shared/**/*.ts\"",
    "format:check": "prettier --check \"client/src/**/*.{ts,tsx,css}\" \"shared/**/*.ts\"",
    "licenses": "license-checker-rseidelsohn --production --plainVertical --out THIRD-PARTY-NOTICES.txt",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-accordion": "^1.2.4",
    "@radix-ui/react-alert-dialog": "^1.1.7",
    "@radix-ui/react-aspect-ratio": "^1.1.3",
    "@radix-ui/react-avatar": "^1.1.4",
    "@radix-ui/react-checkbox": "^1.1.5",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-context-menu": "^2.2.7",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-hover-card": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-menubar": "^1.1.7",
    "@radix-ui/react-navigation-menu": "^1.2.6",
    "@radix-ui/react-popover": "^1.1.7",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-radio-group": "^1.2.4",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-separator": "^1.1.3",
    "@radix-ui/react-slider": "^1.2.4",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-toggle": "^1.1.3",
    "@radix-ui/react-toggle-group": "^1.1.3",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@strudel/soundfonts": "^1.3.0",
    "@strudel/web": "^1.0.6",
    "audiobuffer-to-wav": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^3.6.0",
    "dexie": "^4.0.11",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^11.13.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.453.0",
    "monaco-editor": "^0.52.2",
    "nanoid": "^5.1.5",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.55.0",
    "react-icons": "^5.4.0",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^6.28.0",
    "react-virtuoso": "^4.18.10",
    "recharts": "^2.15.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.2.5",
    "vaul": "^1.1.2",
    "zod": "^3.24.2",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.15",
    "@tailwindcss/vite": "^4.1.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^43.0.0",
    "electron-builder": "^25.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "license-checker-rseidelsohn": "^5.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.9.10",
    "tailwindcss": "^3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.19",
    "vitest": "^4.1.10",
    "wait-on": "^8.0.0"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "build": {
    "appId": "com.strudel.lab",
    "productName": "Strudel Lab",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Audio"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "extraResources": [
      {
        "from": "extraResources",
        "to": ".",
        "filter": [
          "yt-dlp*"
        ]
      }
    ],
    "asarUnpack": [
      "electron/preload.cjs"
    ]
  }
}
